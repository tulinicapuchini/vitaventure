---
import Layout from '../../layouts/Layout.astro';
import VideoCard from '../../components/VideoCard.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';

const videoList = [
  {
    title: 'Creatine at 45: The 3 Surprising Brain & Longevity Benefits',
    description: 'Why active adults over 40 need cellular ATP support more than 20-year-olds. How creatine preserves fast-twitch fibers and buffers sleep deprivation.',
    duration: '0:54',
    category: 'Supplements & ATP',
    date: 'May 2025',
    thumbnail: '/images/logo.png',
  },
  {
    title: 'Morning Dopamine & Sunlight Protocol (Huberman Method)',
    description: 'How 10-15 minutes of direct low-solar-angle morning light triggers melanopsin ganglion cells, setting cortisol rhythm and melatonin release 16 hours later.',
    duration: '0:48',
    category: 'Circadian Biology',
    date: 'April 2025',
    thumbnail: '/images/logo.png',
  },
  {
    title: 'Overcoming Anabolic Resistance After 40',
    description: 'Why aging muscle requires higher leucine concentrations (2.5g+) to trigger mTORC1 and myofibrillar protein synthesis. Practical meal distribution rules.',
    duration: '1:02',
    category: 'Strength & Nutrition',
    date: 'April 2025',
    thumbnail: '/images/logo.png',
  },
  {
    title: 'Magnesium L-Threonate: The Only Form That Crosses the Blood-Brain Barrier',
    description: 'Comparing glycinate, malate, citrate, and threonate for sleep architecture, slow-wave sleep depth, and synaptic plasticity.',
    duration: '0:56',
    category: 'Sleep & Brain',
    date: 'March 2025',
    thumbnail: '/images/logo.png',
  },
  {
    title: 'Zone 2 Cardio: The Mitochondrial Longevity Secret',
    description: 'Why 150-180 minutes weekly of conversational pace exercise accelerates lactate clearance, fat oxidation, and metabolic flexibility.',
    duration: '0:59',
    category: 'Cardiovascular Health',
    date: 'March 2025',
    thumbnail: '/images/logo.png',
  },
  {
    title: 'Cold Plunge vs. Hot Sauna: The Optimal Sequence',
    description: 'Heat shock proteins, growth hormone release, and norepinephrine spikes. How to time heat and cold exposure so you do not blunt resistance training gains.',
    duration: '0:51',
    category: 'Recovery Protocols',
    date: 'February 2025',
    thumbnail: '/images/logo.png',
  },
];
---

<Layout
  title="Video Hub: 60-Second Longevity & Health Reels — VitaVenture"
  description="Watch bite-sized, high-density scientific breakdowns and practical lifestyle protocols optimized for YouTube Shorts, Instagram Reels, and TikTok."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-12">
    
    <!-- Header -->
    <div class="max-w-3xl space-y-4">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 text-rose-800 border border-rose-200">
          ▶ High-Density Visual Protocols
        </span>
      </div>
      <h1 class="serif-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight">
        Short-Form Video Hub
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Produced by the VitaVenture Autonomous Content Engine. Each 60-second video delivers a single peer-reviewed mechanism, actionable protocol, and clinical takeaway.
      </p>
    </div>

    <!-- Platform Subscription Banner -->
    <div class="rounded-2xl bg-white border border-slate-200 p-6 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xs">
      <div class="space-y-1 text-center sm:text-left">
        <h3 class="serif-heading text-lg font-bold text-slate-900">Follow Our Daily Video Drops</h3>
        <p class="text-xs text-slate-600">Catch new protocols every Tuesday and Friday across your favorite platform.</p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="https://youtube.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-xl transition-all shadow-xs"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          YouTube Shorts
        </a>
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 hover:opacity-95 text-white text-xs font-bold rounded-xl transition-all shadow-xs"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          Instagram Reels
        </a>
      </div>
    </div>

    <!-- Video Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {videoList.map((video) => (
        <VideoCard
          title={video.title}
          description={video.description}
          duration={video.duration}
          category={video.category}
          date={video.date}
          thumbnail={video.thumbnail}
        />
      ))}
    </div>

    <NewsletterBox />

  </div>
</Layout>
