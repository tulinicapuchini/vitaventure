---
interface Props {
  target: string;
  dosage: string;
  timing: string;
  synergies?: string;
  caution?: string;
}

const { target, dosage, timing, synergies, caution } = Astro.props;
---

<aside class="my-8 rounded-2xl bg-white border-2 border-sage-700/20 shadow-md p-6 sm:p-7 relative overflow-hidden not-prose">
  <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-sage-700 via-emerald-600 to-amber-500"></div>

  <div class="flex items-center gap-2.5 mb-4">
    <div class="w-7 h-7 rounded-lg bg-sage-100 flex items-center justify-center text-sage-800">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
      </svg>
    </div>
    <span class="text-xs font-bold uppercase tracking-wider text-sage-800">The VitaVenture Evidence-Based Protocol</span>
  </div>

  <h3 class="serif-heading text-xl font-bold text-slate-900 mb-4">{target}</h3>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
    <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/70">
      <span class="text-xs font-semibold uppercase text-slate-500 block mb-1">Standard Daily Dosage</span>
      <span class="font-bold text-slate-900 text-base">{dosage}</span>
    </div>

    <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/70">
      <span class="text-xs font-semibold uppercase text-slate-500 block mb-1">Optimal Timing & Intake</span>
      <span class="font-medium text-slate-800">{timing}</span>
    </div>

    {synergies && (
      <div class="p-3.5 rounded-xl bg-sage-50/70 border border-sage-200/70 sm:col-span-2">
        <span class="text-xs font-bold uppercase text-sage-800 block mb-1">Absorption Synergies & Co-Factors</span>
        <span class="text-slate-700">{synergies}</span>
      </div>
    )}

    {caution && (
      <div class="p-3.5 rounded-xl bg-amber-50/70 border border-amber-200/70 sm:col-span-2 text-xs">
        <strong class="font-semibold text-amber-900 block mb-0.5">Clinical Note:</strong>
        <span class="text-amber-800 leading-relaxed">{caution}</span>
      </div>
    )}
  </div>
</aside>
