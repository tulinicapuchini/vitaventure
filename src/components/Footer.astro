---
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 pb-12 border-b border-slate-800">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3.5">
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl overflow-hidden bg-white p-1.5 shadow-sm border border-slate-700 shrink-0 flex items-center justify-center">
            <img src="/images/logo.png" alt="VitaVenture Logo" class="w-full h-full object-contain" />
          </div>
          <div>
            <span class="serif-heading text-2xl sm:text-3xl font-bold text-white tracking-tight block leading-none">VitaVenture</span>
            <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-sage-400 block mt-1">Science &bull; Longevity &bull; Protocols</span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          Science-backed wellness, longevity research, and real-life lifestyle protocols designed for high performance, vitality, and health after 40.
        </p>
        <div class="flex items-center gap-4 pt-2">
          <!-- X / Twitter -->
          <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center text-slate-400 hover:text-white transition-colors" aria-label="VitaVenture on X">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <!-- YouTube -->
          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center text-slate-400 hover:text-white transition-colors" aria-label="VitaVenture on YouTube">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <!-- Instagram -->
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center text-slate-400 hover:text-white transition-colors" aria-label="VitaVenture on Instagram">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        </div>
      </div>

      <!-- Categories -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-widest text-slate-100">Categories</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/blog?category=Supplements" class="hover:text-white transition-colors">Supplements & Nootropics</a></li>
          <li><a href="/blog?category=Longevity" class="hover:text-white transition-colors">Longevity & Cellular Health</a></li>
          <li><a href="/blog?category=Fitness Over 40" class="hover:text-white transition-colors">Fitness & Strength Over 40</a></li>
          <li><a href="/blog?category=Nutrition" class="hover:text-white transition-colors">Nutrition & Fasting</a></li>
          <li><a href="/blog?category=Mind & Sleep" class="hover:text-white transition-colors">Sleep & Recovery Protocols</a></li>
        </ul>
      </div>

      <!-- Navigation & Tools -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-widest text-slate-100">Explore</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/blog" class="hover:text-white transition-colors">All Research Articles</a></li>
          <li><a href="/videos" class="hover:text-white transition-colors">Shorts & Video Reels</a></li>
          <li><a href="/tools" class="hover:text-white transition-colors">Creatine Dosage Calculator</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">Editorial Philosophy</a></li>
        </ul>
      </div>

      <!-- Weekly Briefing -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-widest text-slate-100">The Weekly Protocol</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Join 10,000+ readers receiving one actionable, science-tested protocol every Sunday.
        </p>
        <form class="space-y-2" id="footer-newsletter-form">
          <input
            type="email"
            placeholder="Your email address"
            required
            class="w-full px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-xs text-white placeholder-slate-500 focus:outline-none focus:border-sage-500"
          />
          <button
            type="submit"
            class="w-full py-2 px-3 bg-sage-600 hover:bg-sage-500 text-white rounded-lg text-xs font-semibold transition-colors"
          >
            Get Sunday Protocol
          </button>
        </form>
        <script>
          const footerForm = document.getElementById('footer-newsletter-form');
          footerForm?.addEventListener('submit', (e) => {
            e.preventDefault();
            alert('Thank you for subscribing to VitaVenture!');
          });
        </script>
      </div>

    </div>

    <!-- Medical Disclaimer & Legal -->
    <div class="pt-8 space-y-4 text-xs text-slate-500 leading-relaxed">
      <p class="bg-slate-950/60 p-4 rounded-xl border border-slate-800/80">
        <strong class="text-slate-400 font-semibold block mb-1">Medical & Scientific Disclaimer:</strong>
        The content on VitaVenture is for informational, educational, and self-experimentation purposes only. It is not intended as medical advice, diagnosis, or treatment. Always consult a qualified healthcare provider before initiating any new supplement, exercise regimen, or diet protocol.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 text-slate-500">
        <p>&copy; {year} VitaVenture. All rights reserved.</p>
        <div class="flex gap-6">
          <a href="/about" class="hover:text-slate-400 transition-colors">Editorial Policy</a>
          <a href="/about" class="hover:text-slate-400 transition-colors">Privacy</a>
          <a href="/about" class="hover:text-slate-400 transition-colors">Terms</a>
        </div>
      </div>
    </div>
  </div>
</footer>
