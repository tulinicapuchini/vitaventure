---
interface Props {
  title: string;
  description: string;
  duration?: string;
  thumbnail?: string;
  videoUrl?: string;
  category?: string;
  date?: string;
}

const {
  title,
  description,
  duration = '0:58',
  thumbnail = '/images/logo.png',
  videoUrl,
  category = 'Shorts Protocol',
  date = 'Recent',
} = Astro.props;
---

<article class="editorial-card overflow-hidden flex flex-col group">
  <!-- Video Aspect Frame / Preview -->
  <div class="relative aspect-[9/16] sm:aspect-video bg-slate-900 overflow-hidden flex items-center justify-center">
    <img
      src={thumbnail}
      alt={title}
      class="w-full h-full object-cover opacity-80 group-hover:scale-105 group-hover:opacity-95 transition-all duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-black/20"></div>

    <!-- Play button overlay -->
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="w-12 h-12 rounded-full bg-white/90 text-slate-900 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
        <svg class="w-5 h-5 ml-0.5 fill-current" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </div>
    </div>

    <!-- Duration Badge -->
    <span class="absolute bottom-3 right-3 px-2 py-0.5 rounded-md bg-black/70 backdrop-blur-xs text-[11px] font-mono font-medium text-white">
      {duration}
    </span>

    <!-- Category Tag -->
    <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full bg-sage-800/90 text-[11px] font-semibold text-white tracking-wide uppercase">
      {category}
    </span>
  </div>

  <!-- Content -->
  <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
    <div>
      <h3 class="serif-heading text-lg font-bold text-slate-900 group-hover:text-sage-700 transition-colors line-clamp-2">
        {title}
      </h3>
      <p class="text-xs text-slate-600 mt-2 line-clamp-2 leading-relaxed">
        {description}
      </p>
    </div>

    <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <span>{date}</span>
      <a href={videoUrl || '#'} target={videoUrl ? '_blank' : '_self'} rel="noopener noreferrer" class="flex items-center gap-1.5 font-medium text-sage-700 hover:text-sage-900 transition-colors">
        <span>Watch Breakdown</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>
  </div>
</article>
